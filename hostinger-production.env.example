# ==============================================================================
# WA-AKG Hostinger production environment template
# ==============================================================================
# Upload/import this file in Hostinger hPanel Environment variables, then replace:
# - https://azure-dinosaur-903216.hostingersite.com with your final/custom domain if you change it later
# - CHANGE_DB_PASSWORD with your Hostinger MySQL user password
# - AUTH_SECRET, ADMIN_PASSWORD, NEXT_PUBLIC_SWAGGER_PASSWORD with strong values
# - AI_API_KEY only if you want AI auto-replies
#
# Do NOT add PORT or HOSTNAME on Hostinger. Hostinger injects PORT automatically.
# ==============================================================================

DATABASE_URL="mysql://u545116183_naitik:CHANGE_DB_PASSWORD@localhost:3306/u545116183_whatsapp?connection_limit=5&pool_timeout=20"
AUTH_SECRET="CHANGE_THIS_TO_A_RANDOM_32_PLUS_CHARACTER_SECRET"

BASE_URL="https://azure-dinosaur-903216.hostingersite.com"
NEXTAUTH_URL="https://azure-dinosaur-903216.hostingersite.com"
NEXT_PUBLIC_APP_URL="https://azure-dinosaur-903216.hostingersite.com"
NEXT_PUBLIC_API_URL="https://azure-dinosaur-903216.hostingersite.com/api"
AUTH_TRUST_HOST="true"

NODE_ENV="production"
SKIP_DB_PUSH="false"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_THIS_ADMIN_PASSWORD"

KEEP_ALIVE_ENABLED="true"
KEEP_ALIVE_INTERVAL_MINUTES="4"
KEEP_ALIVE_URL=""

APP_NAME="WA-AKG"
LOGO_URL=""
FAVICON_URL=""
NEXT_PUBLIC_CHAT_PAGE_SIZE="50"
NEXT_PUBLIC_ALLOW_INDEXING="false"

NEXT_PUBLIC_SWAGGER_ENABLED="true"
NEXT_PUBLIC_SWAGGER_USERNAME="admin"
NEXT_PUBLIC_SWAGGER_PASSWORD="CHANGE_THIS_SWAGGER_PASSWORD"

BAILEYS_LOG_LEVEL="error"

REMOVE_BG_API_KEY=""

# Optional AI auto-reply provider. Leave AI_API_KEY empty to disable provider calls.
AI_API_KEY=""
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_MODEL="gpt-4o-mini"
AI_TEMPERATURE="0.7"
AI_MAX_TOKENS="500"
AI_SYSTEM_PROMPT="You are a helpful WhatsApp business assistant. Reply clearly and briefly."

ENABLE_NOTIFICATIONS="true"
ENABLE_AUTO_UPDATE_CHECK="true"
ENABLE_EXPERIMENTAL_FEATURES="false"

SESSION_TIMEOUT_HOURS="24"
MAX_UPLOAD_SIZE_MB="50"
ENABLE_RATE_LIMITING="true"
RATE_LIMIT_PER_MINUTE="60"

TZ="Asia/Kolkata"
LOCALE="en-US"
MEDIA_STORAGE_PATH="uploads"
NEXT_PUBLIC_GA_ID=""
